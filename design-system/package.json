{
  "name": "genshi-design-system",
  "private": true,
  "version": "0.2.0",
  "description": "SeamKit → Genshi adaptation reference implementation",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build:tokens": "npm run build -w @genshi/tokens",
    "build:react": "npm run build -w @genshi/react",
    "build": "npm run build:tokens && npm run build:react",
    "test": "npm run test -w @genshi/react",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "dev": "npm run dev -w employee-directory"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.0",
    "@storybook/addon-docs": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "storybook": "^8.6.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
